{
  "$schema": "https://docs.openclaw.ai/schema/openclaw.json",
  "gateway": {
    "mode": "local",
    "port": 18789,
    "bind": "lan",
    "auth": {
      "mode": "token",
      "token": "change_me_to_a_random_secret_string"
    },
    "controlUi": {
      "allowedOrigins": [
        "http://localhost:18789",
        "http://127.0.0.1:18789"
      ]
    },
    "remote": {
      "url": "ws://127.0.0.1:18789",
      "transport": "direct",
      "token": "change_me_to_a_random_secret_string"
    }
  },
  "tools": {
    "profile": "coding"
  },
  "agents": {
    "defaults": {
      "workspace": "/home/node/.openclaw/workspace",
      "model": {
        "primary": "github-copilot/gpt-5.6-sol",
        "fallbacks": [
          "github-copilot/gpt-5.5"
        ]
      },
      "sandbox": {
        "mode": "off"
      },
      "heartbeat": {
        "agentId": "coder"
      },
      "systemAgent": {
        "agentId": "coder"
      },
      "authInheritance": {
        "agentId": "coder"
      }
    },
    "ownership": "explicit",
    "entries": {
      "coder": {
        "name": "Agent A — Coder",
        "workspace": "/home/node/.openclaw/workspace",
        "identity": {
          "name": "Coder",
          "theme": "implementation engineer",
          "emoji": "🧑‍💻"
        },
        "model": {
          "primary": "github-copilot/gpt-5.6-sol"
        },
        "tools": {
          "profile": "coding",
          "deny": [
            "exec",
            "process",
            "browser",
            "web_search",
            "web_fetch",
            "apply_patch"
          ]
        }
      },
      "tester": {
        "name": "Agent B — Tester",
        "workspace": "/home/node/.openclaw/workspace",
        "identity": {
          "name": "Tester",
          "theme": "qa engineer",
          "emoji": "🧪"
        },
        "model": {
          "primary": "github-copilot/gpt-5.6-sol"
        },
        "tools": {
          "profile": "coding",
          "deny": [
            "exec",
            "process",
            "browser",
            "web_search",
            "web_fetch",
            "apply_patch"
          ]
        }
      },
      "runner": {
        "name": "Agent C — Runner",
        "workspace": "/home/node/.openclaw/workspace",
        "identity": {
          "name": "Runner",
          "theme": "test execution & reporting",
          "emoji": "🏃"
        },
        "model": {
          "primary": "github-copilot/gpt-5.6-sol"
        },
        "tools": {
          "profile": "coding",
          "deny": [
            "process",
            "browser",
            "web_search",
            "web_fetch",
            "apply_patch",
            "edit"
          ]
        }
      }
    }
  },
  "plugins": {
    "entries": {
      "github-copilot": {
        "enabled": true
      }
    }
  },
  "meta": {
    "lastTouchedVersion": "2026.9.2",
    "migrations": {
      "modelPolicyAllowlist": true
    }
  },
  "auth": {
    "profiles": {
      "github-copilot:github": {
        "provider": "github-copilot",
        "mode": "token"
      }
    }
  },
  "talk": {
    "agentId": "coder"
  }
}
