# GitHub Copilot model IDs
MODEL_ASTRA="gpt-6-astra"
MODEL_SOL="gpt-5.6-sol"
ORCHESTRATOR_MODEL="gpt-6-astra"

# Durable state lives inside the sandbox and survives stop/start.
SESSION_DIR=/home/agent/state/sessions

# Per-call timeout (seconds).
REQUEST_TIMEOUT=180

# Optional: stable session id (otherwise a UUID is generated each launch)
# SESSION_ID=dev-001
