# Copy this file to .env and fill in real values.

# GitHub token with Copilot access. Prefer passing it through sandbox.sh rather
# than storing it here.
COPILOT_GITHUB_TOKEN=ghu_replace_me

# How many self-correction iterations the orchestrator runs.
MAX_ITERATIONS=4

# Pinned official OpenClaw 2.0 image.
OPENCLAW_IMAGE=ghcr.io/openclaw/openclaw:2026.8.1
